# Build artifacts (Phase 1)
# Ignore only the generated contents of Build/Output/, not the directory itself:
# Client.exe and Driver.sys are the shipped binaries; Objects\ holds all Create.bat
# and MSBuild intermediates (including Objects\Client\Release\).
Build/Output/Client.exe
Build/Output/Driver.sys
Build/Output/Objects/

# MSBuild / linker intermediates (defense in depth if an output dir moves)
*.tlog
*.recipe
*.lastbuildstate
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib

# clangd language-server index cache (redirected outside the repo via .clangd)
.cache/

# Reference asset — supplied locally, never committed
Assets/Target.dll
