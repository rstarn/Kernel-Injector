# Build artifacts (Phase 1)
# Build.bat writes binaries and intermediates under Build/Output/ (including
# Output\Objects\); MSBuild (Build/Project/Client.vcxproj) writes its
# intermediates under Build/Output/Objects/Client/. The whole tree is ignored.
Build/Output/

# MSBuild / linker intermediates (defense in depth if an output dir moves)
*.tlog
*.recipe
*.lastbuildstate
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib

# clangd language-server index cache (redirected outside the repo via .clangd)
.cache/

# Reference asset — supplied locally, never committed
Assets/Target.dll
